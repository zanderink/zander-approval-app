<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title ? `${title} | ${shopName}` : shopName %></title>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#cf1124" />
  <link rel="apple-touch-icon" href="/zander-mark.svg" />
</head>
<body>
  <% const hideTop = typeof showTopActions !== 'undefined' && showTopActions === false; %>
  <header class="topbar no-print">
    <a class="brand brand-lockup" href="/">
      <img src="/zander-mark.svg" alt="<%= shopName %>" class="brand-logo" />
      <span class="brand-copy">
        <strong><%= shopName %></strong>
        <small><%= brandTagline %></small>
      </span>
    </a>
    <% if (!hideTop) { %>
      <div class="top-actions">
        <a class="btn btn-light btn-small" href="/?view=list">List</a>
        <a class="btn btn-light btn-small" href="/?view=board">Board</a>
        <a class="btn btn-light btn-small" href="/jobs/new">+ New Job</a>
        <form action="/logout" method="post" style="margin:0;">
          <button class="btn btn-primary btn-small" type="submit">Log Out</button>
        </form>
      </div>
    <% } %>
  </header>
  <main class="wrap">
    <% if (flash && flash.message) { %>
      <div class="flash-<%= flash.type === 'error' ? 'error' : 'success' %>"><%= flash.message %></div>
    <% } %>
    <%- body %>
    <div class="footer">Built for <%= shopName %> mockup approvals, change requests, and production release.</div>
  </main>
  <script>if ('serviceWorker' in navigator) { window.addEventListener('load', () => navigator.serviceWorker.register('/service-worker.js').catch(()=>{})); }</script>
</body>
</html>
