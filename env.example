<section class="panel">
  <h1 style="margin-top:0;">Edit <%= job.job_number %></h1>
  <form action="/jobs/<%= job.id %>/update" method="post" enctype="multipart/form-data" class="form-grid" autocomplete="off">
    <div><label>Company Name</label><input name="company_name" value="<%= job.company_name || '' %>" /></div>
    <div><label>Customer Name</label><input name="customer_name" value="<%= job.customer_name || '' %>" required /></div>
    <div><label>Customer Email</label><input type="email" name="customer_email" value="<%= job.customer_email || '' %>" required /></div>

    <div class="full">
      <label>Garment</label>
      <div id="garmentRows">
        <% (garments && garments.length ? garments : ['']).forEach((garmentValue, idx) => { %>
          <div class="dynamic-row" data-index="<%= idx %>">
            <select name="garment_<%= idx %>" class="dynamic-select">
              <option value="">Select garment</option>
              <% garmentOptions.forEach(option => { %>
                <option value="<%= option %>" <%= garmentValue === option ? 'selected' : '' %>><%= option %></option>
              <% }) %>
              <option value="__custom__" <%= garmentCustomFlags[idx] ? 'selected' : '' %>>Other / Custom Garment</option>
            </select>
            <input name="garment_custom_<%= idx %>" class="dynamic-custom-input" value="<%= garmentCustomFlags[idx] ? garmentValue : '' %>" placeholder="Type custom garment" style="<%= garmentCustomFlags[idx] ? 'display:block;' : 'display:none;' %>" />
            <% if (idx > 0) { %><button class="btn btn-light btn-small" type="button" onclick="this.parentElement.remove()">Remove</button><% } %>
          </div>
        <% }) %>
      </div>
      <button class="btn btn-light btn-small js-add-row" type="button" data-container="garmentRows" data-prefix="garment" data-options='<%- JSON.stringify(garmentOptions) %>' data-placeholder="Select garment" data-custom-placeholder="Type custom garment">Add Another Garment</button>
    </div>

    <div>
      <label>Garment Color</label>
      <select name="garment_color" id="garment_color_select">
        <option value="">Select color</option>
        <% garmentColorOptions.forEach(color => { %>
          <option value="<%= color %>" <%= job.garment_color === color ? 'selected' : '' %>><%= color %></option>
        <% }) %>
        <option value="__custom__" <%= garmentColorIsCustom ? 'selected' : '' %>>Other / Custom Color</option>
      </select>
      <input name="garment_color_custom" id="garment_color_custom" value="<%= garmentColorIsCustom ? job.garment_color : '' %>" placeholder="Type custom garment color" style="margin-top:8px;<%= garmentColorIsCustom ? 'display:block;' : 'display:none;' %>" />
    </div>

    <div>
      <label>Process</label>
      <select name="process" id="process_select">
        <option value="">Select process</option>
        <% processOptions.forEach(option => { %>
          <option value="<%= option %>" <%= job.process === option ? 'selected' : '' %>><%= option %></option>
        <% }) %>
        <option value="__custom__" <%= processIsCustom ? 'selected' : '' %>>Other / Custom</option>
      </select>
      <input name="process_custom" id="process_custom" value="<%= processIsCustom ? job.process : '' %>" placeholder="Type custom process" style="margin-top:8px;<%= processIsCustom ? 'display:block;' : 'display:none;' %>" />
    </div>

    <div class="full">
      <label>Print Locations</label>
      <div id="printLocationRows">
        <% (printLocationList && printLocationList.length ? printLocationList : ['']).forEach((locationValue, idx) => { %>
          <div class="dynamic-row" data-index="<%= idx %>">
            <select name="print_location_<%= idx %>" class="dynamic-select">
              <option value="">Select print location</option>
              <% printLocationOptions.forEach(option => { %>
                <option value="<%= option %>" <%= locationValue === option ? 'selected' : '' %>><%= option %></option>
              <% }) %>
              <option value="__custom__" <%= printLocationCustomFlags[idx] ? 'selected' : '' %>>Other / Custom</option>
            </select>
            <input name="print_location_custom_<%= idx %>" class="dynamic-custom-input" value="<%= printLocationCustomFlags[idx] ? locationValue : '' %>" placeholder="Type custom print location" style="<%= printLocationCustomFlags[idx] ? 'display:block;' : 'display:none;' %>" />
            <% if (idx > 0) { %><button class="btn btn-light btn-small" type="button" onclick="this.parentElement.remove()">Remove</button><% } %>
          </div>
        <% }) %>
      </div>
      <button class="btn btn-light btn-small js-add-row" type="button" data-container="printLocationRows" data-prefix="print_location" data-options='<%- JSON.stringify(printLocationOptions) %>' data-placeholder="Select print location" data-custom-placeholder="Type custom print location">Add Another Location</button>
    </div>

    <div><label>Imprint Colors</label><input name="imprint_colors" value="<%= job.imprint_colors || '' %>" /></div>
    <div><label>Total Price</label><input name="total_price" value="<%= job.total_price || '' %>" /></div>
    <div><label>Due Date</label><input type="date" name="due_date" value="<%= job.due_date || '' %>" /></div>
    <div><label>Rush</label><select name="rush"><option value="no" <%= !job.rush ? 'selected' : '' %>>No</option><option value="yes" <%= job.rush ? 'selected' : '' %>>Yes</option></select></div>
    <div><label>Fulfillment</label><select name="fulfillment"><option value="" <%= !job.tags?.pickup && !job.tags?.ship ? 'selected' : '' %>>None</option><option value="Pickup" <%= job.tags?.pickup ? 'selected' : '' %>>Pickup</option><option value="Ship" <%= job.tags?.ship ? 'selected' : '' %>>Ship</option></select></div>
    <div><label>Shipping Method</label><input name="shipping_method" value="<%= job.shipping_method || '' %>" /></div>
    <div><label>Approval Status</label><select name="approval_status"><% approvalStatuses.forEach(status => { %><option value="<%= status %>" <%= job.approval_status===status ? 'selected' : '' %>><%= status %></option><% }) %></select></div>
    <div><label>Production Stage</label><select name="production_stage"><% productionStages.forEach(stage => { %><option value="<%= stage %>" <%= job.production_stage===stage ? 'selected' : '' %>><%= stage %></option><% }) %></select></div>

    <div class="full">
      <label>Total Sizes</label>
      <div class="grid-4">
        <% sizeOrder.forEach(size => { %>
          <div>
            <label style="font-size:13px;"><%= size %></label>
            <input type="number" min="0" name="size_<%= size.toLowerCase() %>" value="<%= sizeMap[size] || '' %>" placeholder="0" />
          </div>
        <% }) %>
      </div>
    </div>

    <div class="full"><label>Internal Notes</label><textarea name="internal_notes"><%= job.internal_notes || '' %></textarea></div>
    <div class="full"><label>Customer Requested Changes</label><textarea name="customer_requested_changes"><%= job.customer_requested_changes || '' %></textarea></div>
    <div><label>Add New Mockup Revision</label><input type="file" name="mockup" accept="image/*,.pdf" /></div>
    <div><label>Add Extra Files</label><input type="file" name="attachments" multiple /></div>
    <div class="full"><button class="btn btn-primary" type="submit">Save Changes</button></div>
  </form>
</section>

<script>
  function toggleCustom(selectId, inputId) {
    const select = document.getElementById(selectId);
    const input = document.getElementById(inputId);
    if (!select || !input) return;
    const sync = () => {
      const show = select.value === '__custom__';
      input.style.display = show ? 'block' : 'none';
      if (!show && input.dataset.clearOnHide !== 'false') input.value = '';
    };
    select.addEventListener('change', sync);
    sync();
  }

  function wireDynamicCustom(row) {
    const select = row.querySelector('select');
    const input = row.querySelector('.dynamic-custom-input');
    if (!select || !input) return;
    const sync = () => {
      const show = select.value === '__custom__';
      input.style.display = show ? 'block' : 'none';
      if (!show) input.value = '';
    };
    select.addEventListener('change', sync);
    sync();
  }

  function addDynamicRow(containerId, prefix, options, placeholder, customPlaceholder) {
    const container = document.getElementById(containerId);
    const index = container.querySelectorAll('.dynamic-row').length;
    const row = document.createElement('div');
    row.className = 'dynamic-row';
    row.dataset.index = index;

    const select = document.createElement('select');
    select.name = `${prefix}_${index}`;
    select.className = 'dynamic-select';
    const first = document.createElement('option');
    first.value = '';
    first.textContent = placeholder;
    select.appendChild(first);
    options.forEach(option => {
      const el = document.createElement('option');
      el.value = option;
      el.textContent = option;
      select.appendChild(el);
    });
    const customOption = document.createElement('option');
    customOption.value = '__custom__';
    customOption.textContent = prefix === 'garment' ? 'Other / Custom Garment' : 'Other / Custom';
    select.appendChild(customOption);

    const input = document.createElement('input');
    input.name = `${prefix}_custom_${index}`;
    input.className = 'dynamic-custom-input';
    input.placeholder = customPlaceholder;
    input.style.display = 'none';

    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'btn btn-light btn-small';
    remove.textContent = 'Remove';
    remove.onclick = () => row.remove();

    row.appendChild(select);
    row.appendChild(input);
    row.appendChild(remove);
    container.appendChild(row);
    wireDynamicCustom(row);
  }

  toggleCustom('garment_color_select', 'garment_color_custom');
  toggleCustom('process_select', 'process_custom');
  document.querySelectorAll('.dynamic-row').forEach(wireDynamicCustom);

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.js-add-row').forEach(button => {
      button.addEventListener('click', () => {
        let options = [];
        try { options = JSON.parse(button.dataset.options || '[]'); } catch (e) { options = []; }
        addDynamicRow(
          button.dataset.container,
          button.dataset.prefix,
          options,
          button.dataset.placeholder,
          button.dataset.customPlaceholder
        );
      });
    });
  });
</script>
