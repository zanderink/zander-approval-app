<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Approval Job</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <div class="page">
    <div class="topbar">
      <div>
        <h1 class="brand-title">Create Approval Job</h1>
        <p class="brand-subtitle">Set up the order, upload the mockup, and save it to your dashboard.</p>
      </div>
      <a class="btn btn-light" href="/">Back to Dashboard</a>
    </div>

    <div class="card">
      <form action="/jobs" method="POST" enctype="multipart/form-data" class="form-grid">

        <div>
          <label>Customer Name</label>
          <input name="customer_name" required />
        </div>

        <div>
          <label>Company Name</label>
          <input name="company_name" />
        </div>

        <div>
          <label>Customer Email</label>
          <input type="email" name="customer_email" required />
        </div>

        <div>
          <label>Total Price</label>
          <input name="total_price" placeholder="$499.00" />
        </div>

        <div>
          <label>Garment</label>
          <select name="garment">
            <option value="">Select garment</option>
            <option>Shirt</option>
            <option>Long Sleeve</option>
            <option>Hoodie</option>
            <option>Jacket</option>
            <option>Polo</option>
            <option>1/4 Zip</option>
          </select>
        </div>

        <div>
          <label>Garment Color</label>
          <select name="garment_color" id="garment_color_select">
            <option value="">Select color</option>
            <option>Black</option>
            <option>White</option>
            <option>Sport Grey</option>
            <option>Dark Heather</option>
            <option>Red</option>
            <option>Maroon</option>
            <option>Royal</option>
            <option>Navy</option>
            <option>Carolina Blue</option>
            <option>Forest Green</option>
            <option>Orange</option>
            <option>Purple</option>
            <option>Gold</option>
            <option>Sand</option>
            <option value="__custom__">Other / Custom Color</option>
          </select>
          <input
            name="garment_color_custom"
            id="garment_color_custom"
            placeholder="Type custom garment color"
            style="margin-top:8px;display:none;"
          />
        </div>

        <div>
          <label>Process</label>
          <select name="process">
            <option value="">Select process</option>
            <option>Screen Print</option>
            <option>Embroidery</option>
            <option>Direct to Film</option>
          </select>
        </div>

        <div class="full">
          <label>Print Locations</label>
          <div id="printLocationRows">
            <div class="dynamic-row">
              <select name="print_location_0" class="dynamic-select print-location-select">
                <option value="">Select print location</option>
                <option>Front Left Chest</option>
                <option>Front Left Chest / Back</option>
                <option>Full Front</option>
                <option>Full Front / Full Back</option>
                <option>Sleeve</option>
                <option value="__custom__">Other / Custom</option>
              </select>
              <input
                name="print_location_custom_0"
                class="dynamic-custom-input"
                placeholder="Type custom print location"
              />
              <span></span>
            </div>
          </div>
          <button class="btn btn-light" type="button" id="addLocationBtn">Add Another Location</button>
        </div>

        <div class="full">
          <label>Color of Imprint(s)</label>
          <input name="imprint_colors" placeholder="White front / Red back" />
        </div>

        <div class="full">
          <label>Total Sizes</label>
          <div class="grid-4">
            <div><label style="font-size:13px;">S</label><input type="number" min="0" name="size_s" placeholder="0" /></div>
            <div><label style="font-size:13px;">M</label><input type="number" min="0" name="size_m" placeholder="0" /></div>
            <div><label style="font-size:13px;">L</label><input type="number" min="0" name="size_l" placeholder="0" /></div>
            <div><label style="font-size:13px;">XL</label><input type="number" min="0" name="size_xl" placeholder="0" /></div>
            <div><label style="font-size:13px;">2XL</label><input type="number" min="0" name="size_2xl" placeholder="0" /></div>
            <div><label style="font-size:13px;">3XL</label><input type="number" min="0" name="size_3xl" placeholder="0" /></div>
            <div><label style="font-size:13px;">4XL</label><input type="number" min="0" name="size_4xl" placeholder="0" /></div>
            <div><label style="font-size:13px;">5XL</label><input type="number" min="0" name="size_5xl" placeholder="0" /></div>
          </div>
        </div>

        <div>
          <label>Main Mockup Image</label>
          <input type="file" name="mockup" accept="image/*,.pdf" />
        </div>

        <div class="full">
          <label>Internal Notes</label>
          <textarea name="notes" placeholder="Anything only your team should see"></textarea>
        </div>

        <div class="full">
          <button class="btn btn-primary" type="submit">Save Job</button>
        </div>

      </form>
    </div>
  </div>

  <script>
    function wireDynamicCustom(row) {
      const select = row.querySelector('select');
      const input = row.querySelector('.dynamic-custom-input');
      if (!select || !input) return;

      const sync = () => {
        const show = select.value === '__custom__';
        input.style.display = show ? 'block' : 'none';
        if (!show) input.value = '';
      };

      select.addEventListener('change', sync);
      sync();
    }

    function addDynamicRow() {
      const container = document.getElementById('printLocationRows');
      const index = container.querySelectorAll('.dynamic-row').length;

      const row = document.createElement('div');
      row.className = 'dynamic-row';

      row.innerHTML = `
        <select name="print_location_${index}" class="dynamic-select print-location-select">
          <option value="">Select print location</option>
          <option>Front Left Chest</option>
          <option>Front Left Chest / Back</option>
          <option>Full Front</option>
          <option>Full Front / Full Back</option>
          <option>Sleeve</option>
          <option value="__custom__">Other / Custom</option>
        </select>
        <input
          name="print_location_custom_${index}"
          class="dynamic-custom-input"
          placeholder="Type custom print location"
        />
        <button type="button" class="btn btn-light" onclick="this.parentElement.remove()">Remove</button>
      `;

      container.appendChild(row);
      wireDynamicCustom(row);
    }

    document.getElementById('addLocationBtn')?.addEventListener('click', addDynamicRow);

    const garmentColorSelect = document.getElementById('garment_color_select');
    const garmentColorCustom = document.getElementById('garment_color_custom');

    if (garmentColorSelect && garmentColorCustom) {
      const syncGarmentColor = () => {
        const show = garmentColorSelect.value === '__custom__';
        garmentColorCustom.style.display = show ? 'block' : 'none';
        if (!show) garmentColorCustom.value = '';
      };
      garmentColorSelect.addEventListener('change', syncGarmentColor);
      syncGarmentColor();
    }

    document.querySelectorAll('.dynamic-row').forEach(wireDynamicCustom);
  </script>
</body>
</html>
