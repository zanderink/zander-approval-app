<!DOCTYPE html>
<html>
<head>
  <title>Zander Ink Dashboard</title>
  <link rel="stylesheet" href="/public/styles.css">
</head>

<body>
  <h1>Zander Ink Dashboard</h1>

  <div style="margin-bottom:20px;">
    <a href="/jobs/new">+ Create New Job</a> |
    <a href="/logout">Log Out</a>
  </div>

  <div class="board">

    <!-- Pending -->
    <div class="column">
      <h3>Pending Approval</h3>
      <% jobs.filter(j => !j.status || j.status === 'Pending Approval').forEach(job => { %>
        <div class="card">
          <strong><%= job.customer_name %></strong><br>
          <%= job.garment %><br>
          <a href="/jobs/<%= job.id %>">Open</a>
        </div>
      <% }) %>
    </div>

    <!-- Changes -->
    <div class="column">
      <h3>Changes Requested</h3>
      <% jobs.filter(j => j.status === 'Changes Requested').forEach(job => { %>
        <div class="card">
          <strong><%= job.customer_name %></strong><br>
          <%= job.garment %><br>
          <a href="/jobs/<%= job.id %>">Open</a>
        </div>
      <% }) %>
    </div>

    <!-- Approved -->
    <div class="column">
      <h3>Approved</h3>
      <% jobs.filter(j => j.status === 'Approved').forEach(job => { %>
        <div class="card">
          <strong><%= job.customer_name %></strong><br>
          <%= job.garment %><br>
          <a href="/jobs/<%= job.id %>">Open</a>
        </div>
      <% }) %>
    </div>

    <!-- Production -->
    <div class="column">
      <h3>In Production</h3>
      <% jobs.filter(j => j.status === 'In Production').forEach(job => { %>
        <div class="card">
          <strong><%= job.customer_name %></strong><br>
          <%= job.garment %><br>
          <a href="/jobs/<%= job.id %>">Open</a>
        </div>
      <% }) %>
    </div>

    <!-- Completed -->
    <div class="column">
      <h3>Completed</h3>
      <% jobs.filter(j => j.status === 'Completed').forEach(job => { %>
        <div class="card">
          <strong><%= job.customer_name %></strong><br>
          <%= job.garment %><br>
          <a href="/jobs/<%= job.id %>">Open</a>
        </div>
      <% }) %>
    </div>

  </div>

</body>
</html>
