<!DOCTYPE html>
<html>
<head>
  <title>Zander Ink Dashboard</title>
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body>
  <h1>Zander Ink Dashboard</h1>

  <div class="top-links">
    <a href="/jobs/new">+ Create New Job</a> |
    <a href="/logout">Log Out</a>
  </div>

  <% const columns = [
    'Pending Approval',
    'Changes Requested',
    'Approved',
    'In Production',
    'Completed'
  ]; %>

  <div class="board">
    <% columns.forEach(column => { %>
      <div class="column" data-status="<%= column %>">
        <h3><%= column %></h3>

        <% jobs
          .filter(j => (j.status || 'Pending Approval') === column || (!j.status && column === 'Pending Approval'))
          .forEach(job => { %>
         <div class="board-card" draggable="true" data-id="<%= job.id %>" data-status="<%= job.status || 'Pending Approval' %>">
  <% if (job.mockup) { %>
    <img
  src="<%= job.mockup %>"
  alt="Mockup"
  class="job-thumb preview-img"
  onclick="openPreview('<%= job.mockup %>', '<%= job.customer_name || 'No customer' %>', '<%= job.process || 'Print' %>', '<%= job.total_price || '' %>', '/jobs/<%= job.id %>')"
>
  <% } else { %>
    <div class="job-thumb job-thumb-placeholder">No Preview</div>
  <% } %>

  <div class="badge"><%= job.process || 'Print' %></div>
    <div class="job-card-top">
      <div class="job-name"><%= job.customer_name || 'No customer' %></div>
      <div class="job-badge <%= (job.approval_status || 'waiting').toLowerCase().replace(/\s+/g,'-') %>">
        <%= job.approval_status || 'Waiting' %>
      </div>
    </div>

    <div class="job-meta"><%= job.company_name || '' %></div>
   <div class="job-meta"><strong><%= job.process || '' %></strong></div>
    <div class="job-meta"><%= job.garment_color || '' %></div>

    <div class="job-bottom">
      <div class="job-price"><%= job.total_price || '' %></div>
      <a href="/jobs/<%= job.id %>" class="open-btn">Open Job</a>
    </div>
  </div>
</div> 
        <% }) %>
      </div>
    <% }) %>
  </div>

  <script>
    let draggedCard = null;

    document.querySelectorAll('.board-card').forEach(card => {
      card.addEventListener('dragstart', () => {
        draggedCard = card;
        card.classList.add('dragging');
      });

      card.addEventListener('dragend', () => {
        card.classList.remove('dragging');
        draggedCard = null;
      });
    });

    document.querySelectorAll('.column').forEach(column => {
      column.addEventListener('dragover', e => {
        e.preventDefault();
      });

      column.addEventListener('drop', async e => {
        e.preventDefault();
        if (!draggedCard) return;

        column.appendChild(draggedCard);

        const jobId = draggedCard.dataset.id;
        const status = column.dataset.status;

        try {
          const res = await fetch(`/jobs/${jobId}/move`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
          });

          if (!res.ok) {
            alert('Move failed');
            window.location.reload();
          }
        } catch (err) {
          alert('Move failed');
          window.location.reload();
        }
      });
    });
  </script>
</body>
<div id="previewModal" class="preview-modal" onclick="closePreview()">
  <img id="previewImage">
</div>

<script>
function openPreview(src){
  document.getElementById('previewImage').src = src;
  document.getElementById('previewModal').style.display = 'flex';
}

function closePreview(){
  document.getElementById('previewModal').style.display = 'none';
}
</script>
</html>
