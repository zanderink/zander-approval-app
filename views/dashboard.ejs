<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Zander Ink Dashboard</title>
 <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="page">
    <div class="topbar">
      <h1>Zander Ink Dashboard</h1>
      <div class="top-actions">
        <a class="btn btn-primary" href="/jobs/new">+ Create New Job</a>
        <a class="btn btn-light" href="/logout">Log Out</a>
      </div>
    </div>

    <% if (!jobs || jobs.length === 0) { %>
      <div class="card">
        <h2>No jobs yet</h2>
        <p>Create your first approval job.</p>
      </div>
    <% } else { %>
      <div class="job-grid">
        <% jobs.forEach(job => { %>
          <a class="job-card" href="/jobs/<%= job.id %>">
            <div class="job-card-top">
              <strong><%= job.customer_name || 'No customer' %></strong>
              <span class="status-pill"><%= job.status || 'Draft' %></span>
            </div>
            <div><%= job.company_name || '' %></div>
            <div><%= job.garment || '' %></div>
            <div><%= job.total_quantity || '' %> pcs</div>
            <div class="approval-tag <%= (job.approval_status || '').toLowerCase().replace(/\s+/g,'-') %>">
              <%= job.approval_status || 'Waiting' %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
