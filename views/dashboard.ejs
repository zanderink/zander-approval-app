<!DOCTYPE html>
<html>
<head>
  <title>Zander Ink Dashboard</title>
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body>
  <h1>Zander Ink Dashboard</h1>

  <div style="margin-bottom:20px;">
    <a href="/jobs/new">+ Create New Job</a> |
    <a href="/logout">Log Out</a>
  </div>

  <% const columns = [
    'Pending Approval',
    'Changes Requested',
    'Approved',
    'In Production',
    'Completed'
  ]; %>

  <div class="board">
    <% columns.forEach(column => { %>
      <div class="column" data-status="<%= column %>">
        <h3><%= column %></h3>

        <% jobs
          .filter(j => (j.status || 'Pending Approval') === column || (!j.status && column === 'Pending Approval'))
          .forEach(job => { %>
            <div class="card board-card" draggable="true" data-id="<%= job.id %>">
              <strong><%= job.customer_name || 'No customer' %></strong><br>
              <%= job.garment || '' %><br>
              <a href="/jobs/<%= job.id %>">Open</a>
            </div>
        <% }) %>
      </div>
    <% }) %>
  </div>

  <script>
    let draggedCard = null;

    document.querySelectorAll('.board-card').forEach(card => {
      card.addEventListener('dragstart', () => {
        draggedCard = card;
        card.classList.add('dragging');
      });

      card.addEventListener('dragend', () => {
        card.classList.remove('dragging');
        draggedCard = null;
      });
    });

    document.querySelectorAll('.column').forEach(column => {
      column.addEventListener('dragover', e => {
        e.preventDefault();
      });

      column.addEventListener('drop', async e => {
        e.preventDefault();
        if (!draggedCard) return;

        column.appendChild(draggedCard);

        const jobId = draggedCard.dataset.id;
        const status = column.dataset.status;

        try {
          const res = await fetch(`/jobs/${jobId}/move`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
          });

          if (!res.ok) {
            alert('Move failed');
            window.location.reload();
          }
        } catch (err) {
          alert('Move failed');
          window.location.reload();
        }
      });
    });
  </script>
</body>
</html>
