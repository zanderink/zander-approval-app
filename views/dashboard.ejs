<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Zander Ink Dashboard</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <div style="padding:40px;">
    <h1>Zander Ink Dashboard</h1>

<div style="margin:20px 0;">
  <a href="/new-job" style="
    background:#cf1124;
    color:white;
    padding:12px 18px;
    text-decoration:none;
    border-radius:6px;
    font-weight:bold;
  ">
    + Create New Job
  </a>
</div>
    <p>You are logged in.</p>

    <div style="margin:20px 0;">
      <a href="/login">Back to Login</a>
    </div>

    <h2>Jobs</h2>

    <% if (!jobs || jobs.length === 0) { %>
      <p>No jobs yet.</p>
    <% } else { %>
      <ul>
        <% jobs.forEach(job => { %>
          <li style="margin-bottom:10px;">
            <strong><%= job.customer_name || 'No customer name' %></strong>
            <% if (job.company_name) { %> - <%= job.company_name %><% } %>
            <% if (job.status) { %> - <%= job.status %><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</body>
</html>
