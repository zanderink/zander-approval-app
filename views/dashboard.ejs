<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Zander Ink Dashboard</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <div class="page">
    <h1>Zander Ink Dashboard</h1>

    <div class="top-links">
      <a href="/jobs/new">+ Create New Job</a>
      <a href="/logout">Log Out</a>
    </div>

    <% const columns = [
      'Pending Approval',
      'Changes Requested',
      'Approved',
      'In Production',
      'Completed'
    ]; %>

    <div class="board">
      <% columns.forEach(function(column) { %>
        <div class="column" data-status="<%= column %>">
          <h3><%= column %></h3>

          <% jobs
            .filter(function(job) {
              const status = (job.status || '').trim();
              const approval = (job.approval_status || '').trim().toUpperCase();

              if (column === 'Pending Approval') return status === 'Pending Approval' || approval === 'WAITING';
              if (column === 'Approved') return status === 'Approved' || approval === 'APPROVED';
              if (column === 'Changes Requested') return status === 'Changes Requested' || approval === 'REQUEST CHANGES';

              return status === column;
            })
            .forEach(function(job) { %>

            <div class="board-card" draggable="true" data-id="<%= job.id %>" data-status="<%= job.status %>">
              <% if (job.mockup) { %>
                <img
                  src="<%= job.mockup %>"
                  alt="Mockup"
                  class="job-thumb"
                />
              <% } else { %>
                <div class="job-thumb job-thumb-placeholder">No Preview</div>
              <% } %>

              <div class="badge"><%= job.process || 'Print' %></div>
              <div class="job-name"><%= job.customer_name || 'No customer' %></div>
              <div class="job-meta"><%= job.company_name || '' %></div>
              <div class="job-meta"><%= job.approval_status || 'Waiting' %></div>
              <div class="job-meta">Due: <%= job.due_date || '-' %></div>
              <div class="job-meta">PO: <%= job.po_number || '-' %></div>
              <div class="job-meta">Rush: <%= job.rush_order || 'No' %></div>
              <div class="job-price"><%= job.total_price || '' %></div>

              <div class="job-bottom">
                <a href="/jobs/<%= job.id %>" class="open-btn">Open Job</a>
              </div>
            </div>

          <% }) %>
        </div>
      <% }) %>
    </div>
  </div>
</body>
</html>
