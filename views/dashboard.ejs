<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Zander Ink Dashboard</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <div class="page">
    <div class="topbar">
      <div class="brand-wrap">
        <img src="/public/zander-logo.png" alt="Zander Ink Logo" class="brand-logo" onerror="this.style.display='none'">
        <div>
          <h1 class="brand-title">Zander Ink Dashboard</h1>
          <p class="brand-subtitle">Approvals. Changes. Production release.</p>
        </div>
      </div>

      <div class="top-actions">
        <a class="btn btn-primary" href="/jobs/new">+ Create New Job</a>
        <a class="btn btn-light" href="/logout">Log Out</a>
      </div>
    </div>

    <% if (!jobs || jobs.length === 0) { %>
      <div class="card">
        <h2 class="panel-title">No jobs yet</h2>
        <p class="muted">Create your first approval job to get started.</p>
      </div>
    <% } else { %>
      <div class="job-grid">
        <% jobs.forEach(job => { %>
          <a class="job-card" href="/jobs/<%= job.id %>">
            <div class="job-card-top">
              <strong><%= job.customer_name || 'No customer' %></strong>
              <span class="status-pill"><%= job.status || 'Draft' %></span>
            </div>
            <div class="muted"><%= job.company_name || '' %></div>
            <div><%= job.garment || '' %></div>
            <div><%= job.total_quantity || '' %> pcs</div>
            <div class="approval-tag <%= (job.approval_status || 'waiting').toLowerCase().replace(/\s+/g,'-') %>">
              <%= job.approval_status || 'Waiting' %>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</body>
</html>
