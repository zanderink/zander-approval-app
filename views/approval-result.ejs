<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Approval Result</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="page narrow">
    <div class="card">
      <% if (job.approval_status === 'APPROVED') { %>
        <div class="big-banner approved">APPROVED</div>
      <% } else { %>
        <div class="big-banner changes">REQUEST CHANGES</div>
        <% if (job.customer_notes) { %>
          <p><strong>Requested changes:</strong> <%= job.customer_notes %></p>
        <% } %>
      <% } %>

      <p>Thank you. Your response has been saved.</p>
    </div>
  </div>
</body>
</html>
