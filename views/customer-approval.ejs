<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Review Your Mockup</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <div class="page narrow">
    <div class="card">
      <h1 class="panel-title">Review Your Mockup</h1>

      <% if (job && job.mockup) { %>
        <div style="margin-bottom:20px;">
          <img src="<%= job.mockup %>" class="mockup-image" alt="Mockup" />
        </div>
      <% } %>

      <div class="detail-grid">
        <div>
          <p><strong>Customer:</strong> <%= job?.customer_name || '-' %></p>
          <p><strong>Garment:</strong> <%= job?.garment || '-' %></p>
          <p><strong>Garment Color:</strong> <%= job?.garment_color || '-' %></p>
        </div>
        <div>
          <p><strong>Print Locations:</strong> <%= job?.print_locations || '-' %></p>
          <p><strong>Imprint Colors:</strong> <%= job?.imprint_colors || '-' %></p>
          <p><strong>Total Price:</strong> <%= job?.total_price || '-' %></p>
        </div>
      </div>

      <form method="POST" action="/approve/<%= job.id %>" style="margin-top:20px;">
        <label for="customer_notes">If you want changes, type them here:</label>
        <textarea
          id="customer_notes"
          name="customer_notes"
          placeholder="Example: move the back print up, make the left chest smaller, change red to royal"
        ></textarea>

        <div class="button-row">
          <button class="btn btn-green" type="submit" name="action" value="approve">Approve</button>
          <button class="btn btn-red" type="submit" name="action" value="changes">Request Changes</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
