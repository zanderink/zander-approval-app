<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Zander Ink Login</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <div class="login-page">
    <div class="login-card">
      <img src="/public/zander-logo.png" alt="Zander Ink Logo" class="login-logo" onerror="this.style.display='none'">

      <h1 class="login-title">Zander Ink</h1>
      <p class="login-subtitle">Approval System Login</p>

      <form method="POST" action="/login" class="login-form">
        <input type="text" name="username" placeholder="Username" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit" class="btn btn-primary login-btn">Login</button>
      </form>
    </div>
  </div>
</body>
</html>
