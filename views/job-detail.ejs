
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Job Detail</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body>
  <div class="page">
    <div class="topbar">
      <div class="brand-wrap">
        <img src="/public/zander-logo.png" alt="Zander Ink Logo" class="brand-logo" onerror="this.style.display='none'">
        <div>
          <h1 class="brand-title"><%= job.customer_name || 'Job Detail' %></h1>
          <p class="brand-subtitle"><%= job.company_name || '' %></p>
        </div>
      </div>
      <div class="top-actions">
        <a class="btn btn-light" href="/">Back to Dashboard</a>
        <a class="btn btn-primary" href="/jobs/<%= job.id %>/edit">Edit Job</a>
      </div>
    </div>

    <% if (job.approval_status === 'APPROVED') { %>
      <div class="big-banner approved">APPROVED</div>
    <% } else if (job.approval_status === 'REQUEST CHANGES') { %>
      <div class="big-banner changes">
        REQUEST CHANGES
        <% if (job.customer_notes) { %>
          <div class="banner-notes"><%= job.customer_notes %></div>
        <% } %>
      </div>
    <% } %>

    <div class="card">
      <h2 class="panel-title">Production Status</h2>
      <div class="button-row">
        <form method="POST" action="/jobs/<%= job.id %>/status" style="display:inline;">
          <input type="hidden" name="status" value="Pending Approval">
          <button class="btn btn-light" type="submit">Pending Approval</button>
        </form>

        <form method="POST" action="/jobs/<%= job.id %>/status" style="display:inline;">
          <input type="hidden" name="status" value="Changes Requested">
          <button class="btn btn-red" type="submit">Changes Requested</button>
        </form>

        <form method="POST" action="/jobs/<%= job.id %>/status" style="display:inline;">
          <input type="hidden" name="status" value="Approved">
          <button class="btn btn-green" type="submit">Approved</button>
        </form>

        <form method="POST" action="/jobs/<%= job.id %>/status" style="display:inline;">
          <input type="hidden" name="status" value="Ready for Production">
          <button class="btn btn-primary" type="submit">Ready for Production</button>
        </form>

        <form method="POST" action="/jobs/<%= job.id %>/status" style="display:inline;">
          <input type="hidden" name="status" value="In Production">
          <button class="btn btn-primary" type="submit">In Production</button>
        </form>

        <form method="POST" action="/jobs/<%= job.id %>/status" style="display:inline;">
          <input type="hidden" name="status" value="Completed">
          <button class="btn btn-green" type="submit">Completed</button>
        </form>

        <form method="POST" action="/jobs/<%= job.id %>/status" style="display:inline;">
          <input type="hidden" name="status" value="Delivered / Picked Up">
          <button class="btn btn-light" type="submit">Delivered / Picked Up</button>
        </form>
      </div>
    </div>

    <div class="detail-grid">
      <div class="card">
        <h2 class="panel-title">Job Info</h2>
        <p><strong>Company:</strong> <%= job.company_name || '-' %></p>
        <p><strong>Email:</strong> <%= job.customer_email || '-' %></p>
        <p><strong>Garment:</strong> <%= job.garment || '-' %></p>
<p><strong>Due Date:</strong> <%= job.due_date || '-' %></p>
<p><strong>PO Number:</strong> <%= job.po_number || '-' %></p>
<p><strong>Rush Order:</strong> <%= job.rush_order || '-' %></p>
<p><strong>Fulfillment:</strong> <%= job.fulfillment || '-' %></p>
        <p><strong>Garment Color:</strong> <%= job.garment_color || '-' %></p>
        <p><strong>Print Locations:</strong> <%= job.print_locations || '-' %></p>
        <p><strong>Imprint Colors:</strong> <%= job.imprint_colors || '-' %></p>
        <p><strong>Total Sizes:</strong> <%= job.total_sizes || '-' %></p>
        <p><strong>Total Quantity:</strong> <%= job.total_quantity || '-' %></p>
        <p><strong>Total Price:</strong> <%= job.total_price || '-' %></p>
        <p><strong>Status:</strong> <%= job.status || '-' %></p>
        <% if (job.notes) { %>
          <p><strong>Internal Notes:</strong> <%= job.notes %></p>
        <% } %>
      </div>

      <div class="card">
        <h2 class="panel-title">Mockup</h2>
        <% if (job.mockup) { %>
          <img src="<%= job.mockup %>" class="mockup-image" alt="Mockup">
        <% } else { %>
          <p class="muted">No mockup uploaded.</p>
        <% } %>
      </div>
    </div>

    <div class="card">
      <h2 class="panel-title">Actions</h2>
      <div class="button-row">
        <form method="POST" action="/jobs/<%= job.id %>/send-approval">
          <button type="submit" class="btn btn-primary">Send / Resend Approval</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
